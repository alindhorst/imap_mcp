<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>de.alexanderlindhorst.imapmcp</groupId>
    <artifactId>imap-mcp-parent</artifactId>
    <version>0.2.0</version>
  </parent>
  <artifactId>imap-mcp-it</artifactId>
  <name>IMAP MCP :: Integration tests</name>
  <!-- End-to-end tests only (Testcontainers, GreenMail, Toxiproxy, McpClient). Runs in the verify phase. -->
  <properties>
    <!-- Test-only module: nothing to install or deploy (it has no main artifact, see skipIfEmpty below). -->
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>
  <dependencies>
    <!-- Test scope only for reactor ordering (the app module must be packaged first); the IT launches the shaded jar. -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>imap-mcp-app</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-toxiproxy</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.icegreen</groupId>
      <artifactId>greenmail-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.angus</groupId>
      <artifactId>angus-mail</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The SDK client (StdioClientTransport, McpSyncClient) and its Jackson 3 mapper; versions from the parent. -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-json-jackson3</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <!-- No main classes: without this a second package phase in one invocation ("mvn package package", IDE goal
           lists) fails with "use a classifier to attach supplemental artifacts" (#144). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <skipIfEmpty>true</skipIfEmpty>
        </configuration>
      </plugin>
      <!-- Hands the shaded jar of imap-mcp-app to the ITs. Resolved from the reactor (attached artifact, classifier "all")
           under a plain "mvn verify"; no prior "install" needed (verified in #51). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-shaded-jar</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>${project.groupId}</groupId>
                  <artifactId>imap-mcp-app</artifactId>
                  <version>${project.version}</version>
                  <classifier>all</classifier>
                  <type>jar</type>
                  <outputDirectory>${project.build.directory}/it-jar</outputDirectory>
                  <destFileName>imap-mcp.jar</destFileName>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <systemPropertyVariables>
            <imapmcp.jar>${project.build.directory}/it-jar/imap-mcp.jar</imapmcp.jar>
            <imapmcp.requireDocker>true</imapmcp.requireDocker>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!-- Opt-in smoke tests against real accounts (#258, SPEC 5.8): mvn -Psmoke -pl imap-mcp-it -am verify.
         They are named *LiveSmoke so neither surefire nor failsafe selects them by default. The profile runs only
         them (no Docker needed) and every one is skipped, with a reason, unless IMAP_MCP_SMOKE_* is set in the
         environment (see SmokeEnv). Credentials never go through this pom or the command line. -->
    <profile>
      <id>smoke</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <includes>
                <include>**/*LiveSmoke.java</include>
              </includes>
              <systemPropertyVariables>
                <imapmcp.requireDocker>false</imapmcp.requireDocker>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
