<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.alexanderlindhorst.imapmcp</groupId>
    <artifactId>imap-mcp-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>imap-mcp-coverage</artifactId>
  <packaging>pom</packaging>
  <name>IMAP MCP - aggregated coverage</name>
  <description>Build-only leaf module: aggregates JaCoCo unit and integration coverage via mvn site. No sources.</description>

  <!-- report-aggregate reads classes, sources and exec data from compile/runtime/provided dependencies only;
       imap-mcp-it has just test classes, so it is test scope (exec data only). -->
  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>imap-mcp-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>imap-mcp-store</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>imap-mcp-transport-stdio</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>imap-mcp-transport-http</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>imap-mcp-app</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>imap-mcp-it</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <reporting>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <reportSets>
          <reportSet>
            <reports>
              <report>report-aggregate</report>
            </reports>
            <configuration>
              <dataFileIncludes>
                <dataFileInclude>target/*.exec</dataFileInclude>
                <dataFileInclude>target/jacoco-children/*.exec</dataFileInclude>
              </dataFileIncludes>
            </configuration>
          </reportSet>
        </reportSets>
      </plugin>
    </plugins>
  </reporting>
</project>
