<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.alexanderlindhorst.imapmcp</groupId>
    <artifactId>imap-mcp-parent</artifactId>
    <version>0.5.0-SNAPSHOT</version>
  </parent>

  <artifactId>imap-mcp-coverage</artifactId>
  <packaging>jar</packaging>
  <name>IMAP MCP - aggregated coverage</name>
  <description>Build-only leaf module: aggregates JaCoCo unit and integration coverage via mvn site, and runs the test-completeness gate (SPEC 5.8) in verify. Nothing depends on it.</description>

  <!-- report-aggregate reads classes, sources and exec data from compile/runtime/provided dependencies only;
       imap-mcp-it has just test classes, so it is test scope (exec data only). -->
  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>imap-mcp-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>imap-mcp-store</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>imap-mcp-transport-stdio</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>imap-mcp-transport-http</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>imap-mcp-app</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>imap-mcp-it</artifactId>
      <version>${project.version}</version>
      <type>pom</type> <!-- imap-mcp-it builds no main jar; the reactor GAV match is enough for the exec data -->
      <scope>test</scope>
    </dependency>
  </dependencies>

  <properties>
    <!-- Session start with millisecond resolution (UTC); the gate ignores reports older than it. -->
    <maven.build.timestamp.format>yyyyMMddHHmmssSSS</maven.build.timestamp.format>
    <!-- Defaults for the gate arguments below; -DskipTests, -DskipITs, -Dmaven.test.skip and -Dimapmcp.partialBuild
         on the command line override them. -->
    <skipTests>false</skipTests>
    <skipITs>false</skipITs>
    <maven.test.skip>false</maven.test.skip>
    <imapmcp.partialBuild>false</imapmcp.partialBuild>
  </properties>

  <build>
    <plugins>
      <!-- Test-completeness gate (SPEC 5.8, #426): plain Java, not a surefire test, so -DskipTests cannot silence it.
           This module is reactor-last, so every report of the build exists when it runs in verify. exec:java runs in
           the Maven JVM and a failure is the exception of main (no System.exit). -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>test-completeness-gate</id>
            <phase>verify</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>de.alexanderlindhorst.imapmcp.buildgate.TestCompletenessGate</mainClass>
              <arguments>
                <argument>${session.executionRootDirectory}</argument>
                <argument>${maven.build.timestamp}</argument>
                <argument>${skipTests}</argument>
                <argument>${skipITs}</argument>
                <argument>${maven.test.skip}</argument>
                <argument>${imapmcp.partialBuild}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The live smoke run is a partial build (its *LiveSmoke tests skip without IMAP_MCP_SMOKE_*, no *IT runs). -->
    <profile>
      <id>smoke</id>
      <properties>
        <imapmcp.partialBuild>true</imapmcp.partialBuild>
      </properties>
    </profile>
  </profiles>

  <reporting>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <reportSets>
          <reportSet>
            <reports>
              <report>report-aggregate</report>
            </reports>
            <configuration>
              <dataFileIncludes>
                <dataFileInclude>target/*.exec</dataFileInclude>
                <dataFileInclude>target/jacoco-children/*.exec</dataFileInclude>
              </dataFileIncludes>
            </configuration>
          </reportSet>
        </reportSets>
      </plugin>
    </plugins>
  </reporting>
</project>
