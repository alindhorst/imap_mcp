# Template of app/config.yaml (rendered by setup.sh, which replaces the example.com host names).
# Secrets are env references only; compose passes them from .env.
db:
  url: jdbc:postgresql://postgres:5432/imapmcp
  username: imapmcp
  password: env:IMAPMCP_DB_PASSWORD
oauth:
  issuer: https://idp.example.com/realms/imap-mcp
  resource: https://mail.example.com/mcp
  requiredRole: imap-mcp-user
  webClientId: imap-mcp-web
  webClientSecret: env:WEB_CLIENT_SECRET
  # upstream:
  #   providers:
  #     # Experimental XOAUTH2 (SPEC 5.7, v0.29), not verified against the real providers. Uncomment to enable.
  #     # Secrets are env: or file: references only. The redirect URI to register is
  #     # <public.baseUrl>/accounts/oauth/<id>/callback. The IMAP hosts must be in ssrf.allowedHosts.
  #     gmail:
  #       kind: google
  #       clientId: your-google-client-id
  #       clientSecret: env:GOOGLE_CLIENT_SECRET
  #       label: Gmail
  #     work-microsoft:
  #       kind: microsoft
  #       clientId: your-microsoft-client-id
  #       clientSecret: env:MICROSOFT_CLIENT_SECRET
  #       tenant: organizations
  #     corp:
  #       kind: generic
  #       clientId: your-client-id
  #       clientSecret: file:/run/secrets/corp_client_secret
  #       authorizationEndpoint: https://login.corp.example.com/authorize
  #       tokenEndpoint: https://login.corp.example.com/token
  #       scopes: ["https://imap.example.com/.default", "offline_access"]
  #       imap:
  #         host: imap.example.com
  #         port: 993
  #         security: implicit-tls
public:
  baseUrl: https://mail.example.com
security:
  handleKeys:
    - id: 1
      key: env:HANDLE_KEY_1
  signingKeyId: 1
ssrf:
  # IMAP hosts a user may link; setup.sh replaces this line from IMAP_HOSTS
  allowedHosts: ["imap.example.com"]
kms:
  provider: local
  local:
    currentKekId: kek-1
    keks:
      - id: kek-1
        key: env:KEK_1
http:
  # keep both off until the owner checklist in README.md has passed
  stateful: false
purge:
  enabled: false
