# Placeholders only. setup.sh generates the real .env (mode 0600) and never overwrites an existing one.
# Secrets: openssl rand -hex 32 (passwords); HANDLE_KEY_1 and KEK_1: openssl rand 32 | basenc --base64url | tr -d '=\n'
# (base64url without padding, 32 bytes, one separate run per key).

# Public names (two DNS names) and origins; the origin carries the port only if it is not 443.
MCP_HOST=mail.example.com
IDP_HOST=idp.example.com
MCP_ORIGIN=https://mail.example.com
IDP_ORIGIN=https://idp.example.com
# Let's Encrypt contact (public variant)
ACME_EMAIL=owner@example.com
# public or local (local CA, port HTTPS_PORT)
CADDY_SITE=public
HTTPS_PORT=443
HTTP_PORT=80
# Loopback port of the app (preflight /health only)
APP_PORT=8080
# Local variant only: truststore with the local CA
APP_JDK_JAVA_OPTIONS=

POSTGRES_PASSWORD=<generate>
KEYCLOAK_DB_PASSWORD=<generate>
IMAPMCP_DB_PASSWORD=<generate>
KEYCLOAK_ADMIN_PASSWORD=<generate>
WEB_CLIENT_SECRET=<generate>
HANDLE_KEY_1=<generate>
KEK_1=<generate>
